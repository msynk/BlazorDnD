@page "/other/native-html"

<PageTitle>Other · Native HTML</PageTitle>

<div class="example">
    <h1>Other &mdash; Native HTML, Text &amp; URLs</h1>
    <p class="lead">
        The target below accepts <code>NativeTypes.Html</code>, <code>NativeTypes.Text</code> and
        <code>NativeTypes.Url</code>. Select some text on another page (or in the box on the right)
        and drag it here, or drag a link / image &mdash; the dropped HTML, plain text and any URLs
        are read from the native <code>DataTransfer</code>.
    </p>

    <DndProvider>
        <div class="row-wrap" style="align-items:flex-start;">
            <DropTarget TItem="object" Context="t" style="display:contents"
                        AcceptTypes="_accepted" OnNativeDrop="HandleNativeDrop">
                <div class="dustbin"
                     style="@($"width:24rem;height:10rem;background:{(t.IsOver ? "#6a1b9a" : "#333")};")">
                    @(t.IsOver ? $"Release ({t.ItemType})" : "Drag selected text / a link here")
                </div>
            </DropTarget>

            <div style="border:1px dashed #aaa;padding:1rem;max-width:18rem;">
                <p>Try selecting and dragging <b>this rich text</b> with a
                    <a href="https://react-dnd.github.io/react-dnd" target="_blank">link inside</a>.</p>
            </div>
        </div>
    </DndProvider>

    @if (_last is not null)
    {
        <div style="margin-top:1.5rem;max-width:42rem;">
            <h3>Last native drop &mdash; <code>@_last.ItemType</code></h3>
            @if (!string.IsNullOrEmpty(_last.Text))
            {
                <p><b>Text:</b> @_last.Text</p>
            }
            @if (_last.Urls.Count > 0)
            {
                <p><b>URLs:</b> @string.Join(", ", _last.Urls)</p>
            }
            @if (!string.IsNullOrEmpty(_last.Html))
            {
                <div>
                    <b>HTML (raw):</b>
                    <pre style="white-space:pre-wrap;background:#f5f5f5;padding:0.5rem;">@_last.Html</pre>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly string[] _accepted =
        { NativeTypes.Html, NativeTypes.Text, NativeTypes.Url };

    private NativeDropEventArgs? _last;

    private void HandleNativeDrop(NativeDropEventArgs e) => _last = e;
}
