@page "/sortable/simple"

<PageTitle>Sortable · Simple</PageTitle>

<div class="example">
    <h1>Sortable &mdash; Simple</h1>
    <p class="lead">
        Each card is <em>both</em> a <code>Draggable</code> and a <code>DropTarget</code>. While
        dragging, the <code>OnHover</code> handler compares the pointer against each card's
        midpoint and reorders the list live. Reordering happens during hover, not on drop.
    </p>

    <DndProvider>
        <div style="max-width:24rem;">
            @foreach (var (card, index) in _cards.Select((c, i) => (c, i)))
            {
                <SortableCard Card="card" Index="index" OnMove="Move" @key="card.Id" />
            }
        </div>
    </DndProvider>

    <p style="margin-top:1rem;color:#777;">Order: @string.Join(", ", _cards.Select(c => c.Text))</p>
</div>

@code {
    private readonly List<SortableCard.CardModel> _cards = new()
    {
        new(1, "Write the docs"),
        new(2, "Review the PR"),
        new(3, "Ship the release"),
        new(4, "Celebrate"),
        new(5, "Sleep"),
    };

    private void Move((int From, int To) move)
    {
        var (from, to) = move;
        if (from < 0 || from >= _cards.Count || to < 0 || to >= _cards.Count) return;
        var card = _cards[from];
        _cards.RemoveAt(from);
        _cards.Insert(to, card);
    }
}
