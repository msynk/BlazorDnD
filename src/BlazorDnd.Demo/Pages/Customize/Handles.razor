@page "/customize/handles"

<PageTitle>Customize · Handles &amp; Previews</PageTitle>

<div class="example">
    <h1>Customize &mdash; Handles &amp; Previews</h1>
    <p class="lead">
        With <code>UseHandle="true"</code> a draggable can only be picked up by a nested
        <code>&lt;BlazorDndDragHandle&gt;</code>. The rest of the element stays interactive. Compare the two
        boxes below: the first drags from anywhere, the second only from its grip.
    </p>

    <BlazorDndDndProvider>
        <div class="row-wrap">
            <BlazorDndDraggable TItem="string" Type="@ItemTypes.Box" Item="@("whole")" Context="d">
                <div class="box" style="opacity:@(d.IsDragging ? "0.4" : "1");width:13rem;">
                    Drag me from anywhere
                </div>
            </BlazorDndDraggable>

            <BlazorDndDraggable TItem="string" Type="@ItemTypes.Box" Item="@("handle")"
                       UseHandle="true" Context="d">
                <div class="box" style="opacity:@(d.IsDragging ? "0.4" : "1");width:13rem;display:flex;align-items:center;">
                    <BlazorDndDragHandle>
                        <span class="handle">⠿</span>
                    </BlazorDndDragHandle>
                    <span>Only the grip drags me</span>
                </div>
            </BlazorDndDraggable>
        </div>

        <BlazorDndDropTarget TItem="string" Accept="@ItemTypes.Box" Context="t"
                    style="display:contents" OnDrop="@(e => _last = e.Item)">
            <div class="dustbin" style="@($"margin-top:1.5rem;width:18rem;background:{(t.IsOver ? "darkgreen" : "#333")};")">
                @(string.IsNullOrEmpty(_last) ? "Drop a box here" : $"Dropped: {_last}")
            </div>
        </BlazorDndDropTarget>
    </BlazorDndDndProvider>
</div>

@code {
    private string? _last;
}
