@page "/nesting/drop-targets"

<PageTitle>Nesting · Drop Targets</PageTitle>

<div class="example">
    <h1>Nesting &mdash; Drop Targets</h1>
    <p class="lead">
        Drop targets can be nested. <code>IsOver</code> is true for every target under the
        pointer, while <code>IsOverShallow</code> (React DnD's <code>isOver({ shallow: true })</code>)
        is true only for the innermost one. Drag the box over the nested squares to see the
        difference.
    </p>

    <BlazorDndDndProvider>
        <BlazorDndDraggable TItem="string" Type="@ItemTypes.Box" Item="@("payload")" Context="d">
            <div class="box" style="margin-bottom:1.5rem;opacity:@(d.IsDragging ? "0.4" : "1")">
                Drag me into the nest
            </div>
        </BlazorDndDraggable>

        @RenderNest(0)
    </BlazorDndDndProvider>

    <p style="margin-top:1rem;">
        <span style="display:inline-block;width:14px;height:14px;background:#ffeb3b;border:1px solid #999;"></span>
        = shallow hover (innermost) &nbsp;
        <span style="display:inline-block;width:14px;height:14px;background:rgba(255,235,59,0.25);border:1px solid #999;"></span>
        = also over (ancestor)
    </p>
</div>

@code {
    private const int Depth = 3;

    private RenderFragment RenderNest(int level) => builder =>
    {
        // recursive nested DropTargets
        var seq = 0;
        builder.OpenComponent<BlazorDndDropTarget<string>>(seq++);
        builder.AddAttribute(seq++, "TItem", typeof(string));
        builder.AddAttribute(seq++, "Accept", ItemTypes.Box);
        builder.AddAttribute(seq++, "style", "display:contents");
        builder.AddAttribute(seq++, "ChildContent",
            (RenderFragment<BlazorDndDropState<string>>)(t => childBuilder =>
            {
                childBuilder.OpenElement(0, "div");
                childBuilder.AddAttribute(1, "class", "nest-box");
                childBuilder.AddAttribute(2, "style", NestStyle(level, t));
                childBuilder.AddContent(3, $"level {level}");
                if (level < Depth)
                {
                    childBuilder.AddContent(4, RenderNest(level + 1));
                }
                childBuilder.CloseElement();
            }));
        builder.CloseComponent();
    };

    private static string NestStyle(int level, BlazorDndDropState<string> t)
    {
        // base colour gets darker as we nest
        var shade = 200 - level * 45;
        var baseColor = $"rgb({shade},{shade + 20},{shade + 40})";
        var bg = baseColor;
        if (t.IsOverShallow) bg = "#ffeb3b";
        else if (t.IsOver) bg = "rgba(255,235,59,0.25)";
        var margin = level == 0 ? "" : "margin-top:0.75rem;";
        return $"background:{bg};{margin}color:#222;";
    }
}
