@page "/dustbin/single"

<PageTitle>Dustbin · Single Target</PageTitle>

<div class="example">
    <h1>Dustbin &mdash; Single Target</h1>
    <p class="lead">
        The simplest setup: a single <code>BlazorDndDropTarget</code> that accepts one item type.
        Drag a box onto the dustbin and it reacts to hover and records the drop.
    </p>

    <BlazorDndDndProvider>
        <BlazorDndDropTarget TItem="BoxItem" Accept="@ItemTypes.Box" Context="t"
                    OnDrop="HandleDrop" style="display:contents">
            <div class="dustbin" style="@DustbinStyle(t)">
                @if (t.IsOver)
                {
                    <span>Release to drop</span>
                }
                else
                {
                    <span>@_label</span>
                }
            </div>
        </BlazorDndDropTarget>

        <div class="row-wrap" style="margin-top:1.5rem;">
            @foreach (var box in _boxes)
            {
                <BlazorDndDraggable TItem="BoxItem" Type="@ItemTypes.Box" Item="box" Context="d">
                    <div class="box" style="opacity:@(d.IsDragging ? "0.4" : "1")">
                        @box.Name
                    </div>
                </BlazorDndDraggable>
            }
        </div>
    </BlazorDndDndProvider>
</div>

@code {
    public record BoxItem(string Name);

    private readonly List<BoxItem> _boxes = new()
    {
        new("Glass"), new("Banana"), new("Paper"),
    };

    private string _label = "Drag a box here";
    private int _droppedCount;

    private void HandleDrop(BlazorDndDropEventArgs<BoxItem> e)
    {
        _droppedCount++;
        _label = $"Last dropped: {e.Item?.Name} (total {_droppedCount})";
    }

    private string DustbinStyle(BlazorDndDropState<BoxItem> t)
    {
        var bg = t.IsOver
            ? (t.CanDrop ? "darkgreen" : "darkred")
            : "#222";
        return $"background-color:{bg};";
    }
}
