@namespace BlazorDnd

@*
    Root of a drag-and-drop context. Equivalent to React DnD's <DndProvider backend={HTML5Backend}>.
    Creates a BlazorDndDragDropManager and cascades it to all descendant BlazorDndDraggable / BlazorDndDropTarget / BlazorDndDragLayer
    components. Nest these providers if you need isolated drag contexts.
*@

<CascadingValue Value="_manager" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Optional externally-owned manager. When omitted, one is created for this subtree.</summary>
    [Parameter] public BlazorDndDragDropManager? Manager { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private BlazorDndDragDropManager? _manager;

    protected override void OnParametersSet()
    {
        var manager = Manager ?? _manager ?? new BlazorDndDragDropManager();
        // the cascade is fixed: descendants keep the manager they were initialized with
        if (_manager is not null && !ReferenceEquals(manager, _manager))
            throw new InvalidOperationException(
                $"The {nameof(Manager)} of a {nameof(BlazorDndDndProvider)} cannot be changed after it has been set.");
        _manager = manager;
    }
}
