@namespace BlazorDnd

@*
    Root of a drag-and-drop context. Equivalent to React DnD's <BlazorDndDndProvider backend={HTML5Backend}>.
    Creates a BlazorDndDragDropManager and cascades it to all descendant BlazorDndDraggable / BlazorDndDropTarget / BlazorDndDragLayer
    components. Nest these providers if you need isolated drag contexts.
*@

<CascadingValue Value="Manager" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>Optional externally-owned manager. When omitted, one is created for this subtree.</summary>
    [Parameter] public BlazorDndDragDropManager? Manager { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Manager ??= new BlazorDndDragDropManager();
    }
}
