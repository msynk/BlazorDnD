@namespace BlazorDnd

@*
    Designates a sub-region of a BlazorDndDraggable (configured with UseHandle="true") as the
    grab handle. The handle is the native draggable element, so only drags that start on it move
    the item; the whole draggable is still used as the drag image.
*@

<div @attributes="AdditionalAttributes"
     style="@StyleWithCursor"
     draggable="@(IsActive ? "true" : null)"
     data-blazor-dnd-handle="">
    @ChildContent
</div>

@code {
    [CascadingParameter] private BlazorDndIDragHandleController? Controller { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Style { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsActive => Controller is { RequiresHandle: true, CanDrag: true };

    private string? StyleWithCursor
    {
        get
        {
            var cursor = Controller?.CanDrag == true ? "cursor: move;" : null;
            if (string.IsNullOrEmpty(Style)) return cursor;
            return cursor is null ? Style : $"{cursor} {Style}";
        }
    }
}
